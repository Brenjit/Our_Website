{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "twogether-brenjit-kaveri",
  "main": "dist/server/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY", "VAPID_SUBJECT"]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "no_bundle": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "twogether-db",
      "database_id": "6e9134a8-aaf4-49d8-94c0-a6882bcab46d",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ]
}
